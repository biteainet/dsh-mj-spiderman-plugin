{
  "name": "dsh-mj-spiderman-plugin",
  "version": "0.4.0",
  "description": "MJ 蜘蛛侠彩蛋插件：任意输入框输入 mj（不分大小写）触发 透明悬浮窗特效，视频+json WebGL 合成（alpha 遮罩 + RGB 通道，参考 shuliko.zh.kg）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "mj",
    "spiderman",
    "webgl",
    "video",
    "easter-egg"
  ],
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "assets/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "assets": {
    "avatar": "assets/mj.png",
    "videos": [
      "assets/video1.mp4",
      "assets/video2.mp4"
    ],
    "configs": [
      "assets/video1.json",
      "assets/video2.json"
    ]
  },
  "license": "MIT",
  "website": "https://shuliko.zh.kg"
}
